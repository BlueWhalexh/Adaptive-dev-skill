{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_suite_version",
    "run_id",
    "manifest_revision",
    "strategy_version",
    "workflow_state",
    "classification",
    "routing",
    "selected_strategy",
    "current_stage",
    "resume",
    "design_control",
    "review_control",
    "artifacts",
    "claims"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [6] },
    "skill_suite_version": { "type": "string" },
    "run_id": { "type": "string" },
    "goal_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "summary", "fingerprint"],
      "properties": {
        "goal_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,80}$" },
        "summary": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "manifest_revision": { "type": "integer" },
    "strategy_version": { "type": "string" },
    "workflow_state": {
      "type": "string",
      "enum": ["intake", "routed", "active", "blocked", "review_ready", "closed"]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
        "required": ["risk", "mode", "scope", "uncertainty", "pattern_familiarity", "profiles"],
      "properties": {
        "risk": { "type": "string", "enum": ["L0", "L1", "L2", "L3"] },
        "mode": { "type": "string", "enum": ["implement", "debug", "review", "design", "verify", "research", "handoff"] },
        "scope": { "type": "string", "enum": ["local", "module", "cross_module", "cross_service"] },
        "uncertainty": { "type": "string", "enum": ["low", "medium", "high"] },
        "pattern_familiarity": { "type": "string", "enum": ["known", "adjacent", "novel", "unknown"] },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["frontend", "api", "data", "auth", "security", "release", "docs", "infra"]
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_depth", "manifest_policy", "spec_system", "execution_engine", "execution_policy", "strategy_id", "required_skills", "skill_plan", "capability_report_ref"],
      "properties": {
        "process_depth": { "type": "string", "enum": ["direct", "selective", "lifecycle"] },
        "manifest_policy": { "type": "string", "enum": ["none", "required"] },
        "spec_system": { "type": "string", "enum": ["none", "openspec", "repo_native", "fallback"] },
        "execution_engine": { "type": "string", "enum": ["none", "local"] },
        "execution_policy": { "type": "object" },
        "strategy_id": { "type": "string" },
        "required_skills": { "type": "array", "items": { "type": "string" } },
        "skill_plan": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "capability_report_ref": { "type": "string" }
      }
    },
    "selected_strategy": { "type": "string" },
    "current_stage": { "type": "string" },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "resume_from_stage", "last_validated_artifact_ids", "blocked_reason"],
      "properties": {
        "checkpoint_id": { "type": "string" },
        "resume_from_stage": { "type": "string" },
        "last_validated_artifact_ids": { "type": "array", "items": { "type": "string" } },
        "blocked_reason": { "type": "string" }
      }
    },
    "design_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "review", "documentation_topology", "triggers", "approval"],
      "properties": {
        "policy": { "type": "string", "enum": ["none", "embedded", "standalone"] },
        "review": { "type": "string", "enum": ["none", "self", "independent", "human"] },
        "documentation_topology": {
          "type": "string",
          "enum": ["compact", "single_file_design", "split_design_workspace"]
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "new_boundary",
              "cross_module_flow",
              "cross_service_flow",
              "public_api",
              "event_contract",
              "data_model",
              "migration",
              "auth_permission_security",
              "secrets_pii_payments",
              "state_machine",
              "concurrency_idempotency_recovery",
              "external_integration",
              "runtime_operability_performance_observability",
              "multiple_viable_approaches"
            ]
          }
        },
        "artifact_id": { "type": "string" },
        "embedded_in": { "type": "string" },
        "section_ref": { "type": "string" },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewer", "reviewer_kind", "evidence_ids"],
          "properties": {
            "status": { "type": "string", "enum": ["pending", "approved", "changes_requested"] },
            "reviewer": { "type": "string" },
            "reviewer_kind": { "type": "string", "enum": ["agent", "human"] },
            "evidence_ids": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "review_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "passes_completed", "last_severity", "decision", "next_action", "repair_stage", "finding_refs"],
      "properties": {
        "stage_id": { "type": "string" },
        "passes_completed": { "type": "integer", "minimum": 0, "maximum": 2 },
        "last_severity": { "type": "string", "enum": ["none", "minor", "major", "critical"] },
        "decision": { "type": "string", "enum": ["pending", "approved", "changes_requested", "human_required"] },
        "next_action": { "type": "string", "enum": ["none", "repair_required", "human_required"] },
        "repair_stage": { "type": "string" },
        "finding_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "status", "version", "producer", "depends_on", "covers_acceptance", "path"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["analysis_pack", "context_manifest", "spec", "acceptance_contract", "technical_design", "plan", "task_packet", "evidence_manifest", "learning_candidate", "implementation", "decision_record"]
          },
          "status": {
            "type": "string",
            "enum": ["missing", "draft", "ready", "approved", "stale", "rejected"]
          },
          "version": { "type": "integer" },
          "producer": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "covers_acceptance": { "type": "array", "items": { "type": "string" } },
          "path": { "type": "string" },
          "digest": { "type": "string" },
          "semantic_owner": { "type": "string" },
          "physical_producer": { "type": "string" },
          "lightweight_exception": { "type": "boolean" }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "validated"],
      "properties": {
        "requested": { "type": "string", "enum": ["none", "dev_done", "integration_done", "handoff_done"] },
        "validated": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "status", "verifier", "evidence_ids", "attested_at", "attestation"],
            "properties": {
              "claim": { "type": "string", "enum": ["dev_done", "integration_done", "handoff_done"] },
              "status": { "type": "string", "enum": ["validated", "rejected", "blocked"] },
              "verifier": { "type": "string" },
              "evidence_ids": { "type": "array", "items": { "type": "string" } },
              "attested_at": { "type": "string" },
              "attestation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["workflow_id", "claim_type", "commit_sha", "strategy_id", "strategy_version", "registry_digest", "evidence_manifest_path", "evidence_manifest_digest", "spec_digest", "acceptance_contract_path", "acceptance_contract_digest", "verifier_id", "verifier_version", "result"],
                "properties": {
                  "workflow_id": { "type": "string" },
                  "claim_type": { "type": "string", "enum": ["dev_done", "integration_done", "handoff_done"] },
                  "commit_sha": { "type": "string" },
                  "strategy_id": { "type": "string" },
                  "strategy_version": { "type": "string" },
                  "registry_digest": { "type": "string" },
                  "evidence_manifest_path": { "type": "string" },
                  "evidence_manifest_digest": { "type": "string" },
                  "spec_digest": { "type": "string" },
                  "acceptance_contract_path": { "type": "string" },
                  "acceptance_contract_digest": { "type": "string" },
                  "verifier_id": { "type": "string" },
                  "verifier_version": { "type": "string" },
                  "result": { "type": "string", "enum": ["pass", "fail", "blocked"] }
                }
              }
            }
          }
        }
      }
    },
    "transition_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transition_id", "stage_id", "status"],
        "properties": {
          "transition_id": { "type": "string" },
          "stage_id": { "type": "string" },
          "status": { "type": "string" },
          "producer_skill": { "type": "string" },
          "producer_actor_id": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "review_decision": { "type": "string" },
          "result_status": { "type": "string", "enum": ["applied", "repair_required", "blocked"] },
          "result_stage": { "type": "string" },
          "result_workflow_state": { "type": "string", "enum": ["intake", "routed", "active", "blocked", "review_ready", "closed"] }
        }
      }
    }
  }
}
