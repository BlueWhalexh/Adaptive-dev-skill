{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "transition_id", "expected_manifest_revision", "stage_id", "producer", "status", "artifact_changes", "evidence_refs", "claim_requests", "discovered_facts", "error"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "workflow_id": { "type": "string" },
    "transition_id": { "type": "string" },
    "expected_manifest_revision": { "type": "integer" },
    "stage_id": { "type": "string" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "version"],
      "properties": {
        "skill": { "type": "string" },
        "version": { "type": "string" },
        "actor_id": { "type": "string" }
      }
    },
    "status": { "type": "string", "enum": ["completed", "blocked", "failed", "human_required"] },
    "artifact_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["change_type", "artifact"],
        "properties": {
          "change_type": { "type": "string", "enum": ["upsert", "content_changed"] },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "status", "version", "producer", "depends_on", "covers_acceptance", "path"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["analysis_pack", "context_manifest", "spec", "acceptance_contract", "technical_design", "plan", "task_packet", "evidence_manifest", "learning_candidate", "implementation", "decision_record"] },
              "status": { "type": "string" },
              "version": { "type": "integer" },
              "producer": { "type": "string" },
              "depends_on": { "type": "array", "items": { "type": "string" } },
              "covers_acceptance": { "type": "array", "items": { "type": "string" } },
              "path": { "type": "string" },
              "digest": { "type": "string" },
              "semantic_owner": { "type": "string" },
              "physical_producer": { "type": "string" },
              "lightweight_exception": { "type": "boolean" }
            }
          }
        }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "claim_requests": { "type": "array", "items": { "type": "string", "enum": ["dev_done", "integration_done", "handoff_done"] } },
    "claim_attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "status", "verifier", "evidence_ids", "attested_at", "attestation"],
        "properties": {
          "claim": { "type": "string", "enum": ["dev_done", "integration_done", "handoff_done"] },
          "status": { "type": "string", "enum": ["validated", "rejected", "blocked"] },
          "verifier": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "attested_at": { "type": "string" },
          "attestation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workflow_id", "claim_type", "commit_sha", "strategy_id", "strategy_version", "registry_digest", "evidence_manifest_path", "evidence_manifest_digest", "spec_digest", "acceptance_contract_path", "acceptance_contract_digest", "verifier_id", "verifier_version", "result"],
            "properties": {
              "workflow_id": { "type": "string" },
              "claim_type": { "type": "string", "enum": ["dev_done", "integration_done", "handoff_done"] },
              "commit_sha": { "type": "string" },
              "strategy_id": { "type": "string" },
              "strategy_version": { "type": "string" },
              "registry_digest": { "type": "string" },
              "evidence_manifest_path": { "type": "string" },
              "evidence_manifest_digest": { "type": "string" },
              "spec_digest": { "type": "string" },
              "acceptance_contract_path": { "type": "string" },
              "acceptance_contract_digest": { "type": "string" },
              "verifier_id": { "type": "string" },
              "verifier_version": { "type": "string" },
              "result": { "type": "string", "enum": ["pass", "fail", "blocked"] }
            }
          }
        }
      }
    },
    "discovered_facts": { "type": "object" },
    "review_result": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["pass_number", "max_severity", "decision", "reviewer_id", "reviewed_producer_ids", "finding_refs"],
      "properties": {
        "pass_number": { "type": "integer", "minimum": 1, "maximum": 2 },
        "max_severity": { "type": "string", "enum": ["none", "minor", "major", "critical"] },
        "decision": { "type": "string", "enum": ["approved", "changes_requested", "human_required"] },
        "reviewer_id": { "type": "string" },
        "reviewed_producer_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "finding_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
