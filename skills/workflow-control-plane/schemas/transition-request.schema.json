{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "from_stage", "to_stage", "exit"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "workflow_id": { "type": "string" },
    "from_stage": { "type": "string" },
    "to_stage": { "type": "string" },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "produced_artifacts", "updated_artifacts", "invalidated_artifacts", "evidence_refs", "claim_requests", "next_recommendation", "error_code"],
      "properties": {
        "status": { "type": "string", "enum": ["completed", "blocked", "failed", "human_required"] },
        "produced_artifacts": { "type": "array", "items": { "type": "object" } },
        "updated_artifacts": { "type": "array", "items": { "type": "object" } },
        "invalidated_artifacts": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "claim_requests": { "type": "array", "items": { "type": "string", "enum": ["dev_done", "integration_done", "handoff_done"] } },
        "next_recommendation": { "type": "string" },
        "error_code": { "type": "string" }
      }
    }
  }
}
