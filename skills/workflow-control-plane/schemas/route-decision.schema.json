{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "classification", "capability_report_ref", "user_constraints", "user_overrides", "ambiguity"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [2] },
    "status": { "type": "string", "enum": ["provisional", "confirmed"] },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "work_intent", "delivery_shape", "scope", "uncertainty", "pattern_familiarity", "profiles", "change_types"],
      "properties": {
        "risk": { "type": "string", "enum": ["L0", "L1", "L2", "L3"] },
        "work_intent": { "type": "string", "enum": ["implement", "debug", "review", "design", "verify", "research", "handoff"] },
        "delivery_shape": { "type": "string", "enum": ["none", "doc_only", "local_change", "feature", "mvp", "spike"] },
        "scope": { "type": "string", "enum": ["local", "module", "cross_module", "cross_service"] },
        "uncertainty": { "type": "string", "enum": ["low", "medium", "high"] },
        "pattern_familiarity": { "type": "string", "enum": ["known", "adjacent", "novel", "unknown"] },
        "profiles": {
          "type": "array",
          "items": { "type": "string", "enum": ["frontend", "api", "data", "auth", "security", "release", "docs", "infra"] }
        },
        "change_types": {
          "type": "array",
          "items": { "type": "string", "enum": ["docs", "visual", "bugfix", "feature", "api_contract", "migration", "refactor"] }
        }
      }
    },
    "capability_report_ref": { "type": "string" },
    "user_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_access", "production_changes", "required_spec_system", "required_execution_engine"],
      "properties": {
        "network_access": { "type": "string", "enum": ["allowed", "forbidden", "unknown"] },
        "production_changes": { "type": "string", "enum": ["allowed", "forbidden", "unknown"] },
        "required_spec_system": { "type": ["string", "null"], "enum": ["none", "openspec", "repo_native", "fallback", null] },
        "required_execution_engine": { "type": ["string", "null"], "enum": ["none", "local", "superpowers", null] }
      }
    },
    "user_overrides": { "type": "array", "items": { "type": "string" } },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons"],
      "properties": {
        "status": { "type": "string", "enum": ["clear", "ambiguous"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
