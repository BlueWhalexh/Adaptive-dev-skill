{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "strategy_id", "strategy_version", "process_depth", "manifest_policy", "spec_system", "execution_engine", "required_skills", "skill_plan", "design_control", "reason"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [2] },
    "strategy_id": { "type": "string" },
    "strategy_version": { "type": "string" },
    "process_depth": { "type": "string", "enum": ["direct", "selective", "lifecycle"] },
    "manifest_policy": { "type": "string", "enum": ["none", "required"] },
    "spec_system": { "type": "string", "enum": ["none", "openspec", "repo_native", "fallback"] },
    "execution_engine": { "type": "string", "enum": ["none", "local", "superpowers"] },
    "required_skills": { "type": "array", "items": { "type": "string" } },
    "skill_plan": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "design_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "review", "documentation_topology", "triggers"],
      "properties": {
        "policy": { "type": "string", "enum": ["none", "embedded", "standalone"] },
        "review": { "type": "string", "enum": ["none", "self", "independent", "human"] },
        "documentation_topology": { "type": "string", "enum": ["compact", "single_file_design", "split_design_workspace"] },
        "triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_design_approval_required", "isolated_review_required", "integration_evidence_required"],
      "properties": {
        "human_design_approval_required": { "type": "boolean" },
        "isolated_review_required": { "type": "boolean" },
        "integration_evidence_required": { "type": "boolean" }
      }
    },
    "capability_report_ref": { "type": "string" },
    "reason": { "type": "string" }
  }
}
