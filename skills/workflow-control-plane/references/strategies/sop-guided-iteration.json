{
  "id": "sop-guided-iteration",
  "version": "2.1",
  "risk": ["L2"],
  "modes": ["implement", "design"],
  "process_depth": "selective",
  "manifest_policy": "required",
  "execution_engine": "local",
  "execution_policy": {"unit": "continuous_batch", "task_risk": "local", "task_exit": "focused_signal", "checkpoint": "batch", "review": "batch_risk", "commit": "batch", "manifest_updates": "stage_only", "max_review_passes": 2},
  "stages": ["read_project_sop", "delta_alignment", "method_selection", "implementation", "chain_verification", "independent_review", "close"],
  "required_artifacts": ["evidence_manifest"],
  "stage_skills": {
    "implementation": ["change-aware-testing"],
    "chain_verification": ["change-aware-testing", "delivery-verification"],
    "independent_review": ["agent-orchestration"]
  },
  "stage_gates": {
    "independent_review": {"allowed_producers": ["agent-orchestration", "human-reviewer"], "min_evidence_refs": 1, "review_mode": "independent", "repair_stage": "implementation"}
  },
  "design_policy": "embedded",
  "design_review": "independent",
  "minimum_close_claim": "dev_done",
  "max_claim_request": "integration_done"
}
