{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_packet_id", "coordination_id", "packet_kind", "role", "purpose", "artifact_refs", "allowed_paths", "forbidden_paths", "instructions", "omissions", "created_from"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "context_packet_id": { "type": "string" },
    "coordination_id": { "type": "string" },
    "packet_kind": { "type": "string", "enum": ["task", "review", "verification"] },
    "role": { "type": "string" },
    "purpose": { "type": "string" },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "type", "path", "status"],
        "properties": {
          "artifact_id": { "type": "string" },
          "type": { "type": "string" },
          "path": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "instructions": { "type": "array", "items": { "type": "string" } },
    "omissions": { "type": "array", "items": { "type": "string" } },
    "review_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_refs", "target_refs", "evidence_refs"],
      "properties": {
        "acceptance_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "target_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "created_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_index", "index_revision"],
      "properties": {
        "artifact_index": { "type": "string" },
        "index_revision": { "type": "integer" }
      }
    }
  }
}
